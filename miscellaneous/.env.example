# TLDR workspace — environment variable skeleton
# Copy to .env and fill in real values. Used by automations (lib/*.py), agents, and python scripts.
# See ai system/automations/lib/ENV_SETUP.md and docs/GSC_GA4_SETUP.md for details.

# -----------------------------------------------------------------------------
# ScrapeCreators / Meta Ad Library (automations 3, 7, 10; competitive_tracker, fb_ad_library_api.py)
# -----------------------------------------------------------------------------
SCRAPECREATORS_API_KEY=

# -----------------------------------------------------------------------------
# LLM APIs (blog_writer_agent, repurpose_agent, humanizer; paid_ads_intelligence; many product/sales/customer-success agents)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OpenRouter — video_script_agent, generate_image.py, social_media_agent fallback (automation 02)
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Ahrefs (automations 1, 5, 7, 8, 9, 10; ahrefs_api.py)
# -----------------------------------------------------------------------------
AHREFS_API_KEY=

# -----------------------------------------------------------------------------
# Meta Ads (automations 3, 4, 6, 9; meta_ads_api.py, paid_ads_intelligence_agent, paid_ads_mvp)
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=

# -----------------------------------------------------------------------------
# Google Ads (automations 3, 4, 6, 9; google_ads_api.py, paid_ads_intelligence_agent)
# -----------------------------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_ACCESS_TOKEN=
# Optional: required if account is under an MCC
GOOGLE_ADS_MANAGER_ID=

# -----------------------------------------------------------------------------
# Google Search Console & GA4 (automations 5, 8; gsc_api.py, search_ranking_agent, seo_auditor, traffic_analytics_agent)
# Optional — leave empty for mock/sitemap-only. See docs/GSC_GA4_SETUP.md.
# -----------------------------------------------------------------------------
GSC_SITE_URL=
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# PageSpeed Insights (site_performance_agent). Optional — leave empty to skip.
# -----------------------------------------------------------------------------
PAGESPEED_API_KEY=

# -----------------------------------------------------------------------------
# Google Docs OAuth (automations 2–10; gdocs_api.py)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID_DOCS=
DEFAULT_GOOGLE_DOCS_FOLDER_ID=

# -----------------------------------------------------------------------------
# Google Sheets service account (automations 1, 4, 6, 7; gsheets_api.py)
# GSHEETS_PRIVATE_KEY: one line, newlines as \n (from service account JSON private_key)
# -----------------------------------------------------------------------------
GSHEETS_CLIENT_EMAIL=
GSHEETS_PRIVATE_KEY=
DRIVE_FOLDER_ID_SHEETS=
DEFAULT_GOOGLE_SHEETS_FOLDER_ID=
