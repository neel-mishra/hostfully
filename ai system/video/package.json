{
  "name": "vibehype-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "./node_modules/.bin/remotion preview src/index.ts",
    "build": "./node_modules/.bin/remotion render src/index.ts HypeVertical-9x16 out/hype-9x16.mp4 --codec=h264",
    "render:vertical": "./node_modules/.bin/remotion render src/index.ts HypeVertical-9x16 out/hype-9x16.mp4 --codec=h264",
    "render:horizontal": "./node_modules/.bin/remotion render src/index.ts HypeHorizontal-16x9 out/hype-16x9.mp4 --codec=h264",
    "run:brief": "node scripts/run-from-brief.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.436",
    "@remotion/renderer": "^4.0.436",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
