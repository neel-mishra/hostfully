# Required
META_ACCESS_TOKEN=your_access_token_here

# Optional (needed for appsecret_proof and OAuth helpers)
META_APP_ID=your_app_id_optional
META_APP_SECRET=your_app_secret_optional
META_BUSINESS_ID=your_business_id_optional
META_AUTO_REFRESH=true

# Optional API tuning
META_API_VERSION=v23.0
META_BASE_URL=https://graph.facebook.com
META_API_TIER=standard
META_MCP_REQUEST_TIMEOUT_MS=30000
META_MCP_DEBUG=0

# Optional UX
MCP_SERVER_NAME=Meta Marketing API Server
MCP_SERVER_VERSION=1.0.0

