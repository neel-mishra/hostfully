# Google Ads MCP configuration

# Required
GOOGLE_ADS_AUTH_TYPE=service_account
GOOGLE_ADS_CREDENTIALS_PATH=/absolute/path/to/service-account.json
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token

# Optional but common for manager-account access
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_IMPERSONATION_EMAIL=

# OAuth-only values, if you switch auth mode
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Runtime
GOOGLE_ADS_API_VERSION=v23
GOOGLE_ADS_TIMEOUT_SECONDS=60
