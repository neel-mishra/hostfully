    <string>com.tldr.tech.competitivetracker.monthly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>/Users/neelmishra/antigravity/synthetic growth/TLDR/python scripts/competitive creative tracker/heartbeat_monthly.py</string>
